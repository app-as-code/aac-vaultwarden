# Copy to .env and set every CHANGE_ME:  cp .env.example .env

# SECRET - set a strong value
ADMIN_TOKEN=CHANGE_ME

# SECRET - set a strong value (must match the POSTGRES_* values)
DATABASE_URL=CHANGE_ME

# SECRET - set a strong value
POSTGRES_PASSWORD=CHANGE_ME

# REQUIRED - set for your environment
SSO_CLIENT_ID=CHANGE_ME

# SECRET - set a strong value
SSO_CLIENT_SECRET=CHANGE_ME

# SECRET - set a strong value
SSO_DEBUG_TOKENS=CHANGE_ME

# default: vaultwarden
POSTGRES_DB=vaultwarden

# default: vaultwarden
POSTGRES_USER=vaultwarden
